### App
APP_ENV=dev
APP_NAME=portfolio-api

### Security (do not commit real values)
# JWT 署名鍵。本番では openssl rand -hex 32 等で必ず差し替える
SECRET_KEY=change-me
# Cookie。本番(HTTPS)では COOKIE_SECURE=true、SAMESITE=strict 推奨
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

### Database
# Docker（推奨）: docker-compose.yml が ${POSTGRES_*} から DATABASE_URL を組み立てる
#                 → 下の DATABASE_URL は無視される。POSTGRES_* のみ設定すればよい
# ローカル直接起動: 下の DATABASE_URL（SQLite 既定）が使われる
#                   PostgreSQL に接続したい場合は postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./database.db

### PostgreSQL（docker-compose の db サービスで使用）
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

### CORS（カンマ区切りで列挙。"*" は使わない）
ALLOWED_ORIGINS=http://localhost:8000

### Sentry（任意）
# SENTRY_DSN=
