### App
APP_ENV=dev
APP_NAME=portfolio-api

### Security (do not commit real values)
# JWT 署名鍵。本番では openssl rand -hex 32 等で必ず差し替える
SECRET_KEY=change-me
# Cookie。本番(HTTPS)では COOKIE_SECURE=true、SAMESITE=strict 推奨
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

### Database
# ローカル（python main.py 直接起動）の既定は SQLite
DATABASE_URL=sqlite:///./database.db

### PostgreSQL（docker-compose で db サービスを使う場合）
# docker-compose.yml が ${POSTGRES_*} を組み立てて DATABASE_URL を生成する
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

### CORS（カンマ区切りで列挙。"*" は使わない）
ALLOWED_ORIGINS=http://localhost:8000

### Sentry（任意）
# SENTRY_DSN=
